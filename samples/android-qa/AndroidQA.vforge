                            }
                          }
                        }
                      ]
                    },
                    "handlers": {
                      "onClick": [
                        {
                          "kind": "setState",
                          "target": "count",
                          "value": {
                            "kind": "literal",
                            "value": 0
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
