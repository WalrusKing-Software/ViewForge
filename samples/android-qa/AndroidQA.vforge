                          "id": "n_inc_t",
                          "type": "compose.material3.Text",
                          "props": {
                            "text": {
                              "kind": "literal",
                              "value": "Increment"
                            }
                          }
                        }
                      ]
                    },
                    "handlers": {
                      "onClick": [
                        {
                          "kind": "adjust",
                          "target": "count",
